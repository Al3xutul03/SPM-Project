@{
    var letters = Enumerable.Range('A', 26).Select(c => ((char)c).ToString()).ToList();
}

<h2 class="converter-title">DECRYPTION GROK</h2>

<div class="colleague-workspace">
    <section class="card lt-converter" aria-label="Formular Decryption Grok">

        <div class="lt-row" style="margin-bottom: 20px;">
            <div class="lt-field" style="width: 100%;">
                <label for="lt-ciphertext-grok">Ciphertext</label>
                <textarea id="lt-ciphertext-grok" rows="4" placeholder="Enter the cipher here..."></textarea>
            </div>
        </div>

        <fieldset class="lt-letters">
            <legend class="lt-legend">Rotors</legend>

            @* Primele 3 căsuțe pentru poziția rotoarelor *@
            <div class="lt-grid lt-grid-first">
                @for (int i = 1; i <= 3; i++)
                {
                    <div class="lt-cell">
                        <span>@i</span>
                        <select id="lt-letter-grok-@i" aria-label="Rotor @i">
                            <option value="">–</option>
                            @foreach (var l in letters)
                            {
                                <option value="@l">@l</option>
                            }
                        </select>
                    </div>
                }
            </div>

            <div class="lt-divider" aria-hidden="true"></div>

            @* Căsuțele pentru Plugboard *@
            <h3 class="lt-subtitle">Plugboard</h3>
            <div class="lt-grid">
                @for (int i = 4; i <= 29; i++)
                {
                    <div class="lt-cell">
                        <span>@letters[i - 4]</span>
                        <select id="lt-letter-grok-@i" class="plugboard-select-grok" data-letter="@letters[i - 4]" aria-label="Letter @letters[i - 4]">
                            <option value="">–</option>
                            @foreach (var l in letters)
                            {
                                <option value="@l">@l</option>
                            }
                        </select>
                    </div>
                }
            </div>
        </fieldset>

        <div style="text-align: center; margin: 25px 0;">
            <button type="button" id="btn-decode-grok" class="lt-button">DECODE</button>
        </div>

        <div class="lt-row">
            <div class="lt-field" style="width: 100%;">
                <label for="lt-plaintext-grok">Plaintext</label>
                <textarea id="lt-plaintext-grok" rows="4" placeholder="The plaintext will appear here..." readonly style="background-color: #f9f6f0;"></textarea>
            </div>
        </div>

    </section>
</div>

<script>
    (function () {
        // Menține simetria perechilor din Plugboard
        $('.plugboard-select-grok').on('change', function () {
            var sourceLetter = $(this).data('letter');
            var targetLetter = $(this).val();

            $('.plugboard-select-grok').each(function () {
                var l = $(this).data('letter');
                if (l !== sourceLetter && $(this).val() === sourceLetter) {
                    $(this).val('');
                }
            });

            if (targetLetter && targetLetter !== sourceLetter) {
                $('.plugboard-select-grok').each(function () {
                    var l = $(this).data('letter');
                    if (l !== targetLetter && $(this).val() === targetLetter && l !== sourceLetter) {
                        $(this).val('');
                    }
                });

                $('.plugboard-select-grok[data-letter="' + targetLetter + '"]').val(sourceLetter);
            } else if (targetLetter === sourceLetter) {
                $(this).val('');
            }
        });

        // Apelul AJAX corectat pentru rutele din HomeController
        $('#btn-decode-grok').on('click', function () {
            var ciphertext = $('#lt-ciphertext-grok').val();
            var rotor1 = $('#lt-letter-grok-1').val();
            var rotor2 = $('#lt-letter-grok-2').val();
            var rotor3 = $('#lt-letter-grok-3').val();

            var pairs = [];
            var seen = {};
            $('.plugboard-select-grok').each(function () {
                var from = $(this).data('letter');
                var to = $(this).val();
                if (to && from !== to && !seen[from] && !seen[to]) {
                    pairs.push(from + to);
                    seen[from] = true;
                    seen[to] = true;
                }
            });

            // Dacă utilizatorul a completat rotoarele, folosim decriptarea cu cheie cunoscută.
            // Altfel, dacă sunt goale, putem lăsa serviciul de atac automat (DecryptGrok).
            var hasRotors = rotor1 && rotor2 && rotor3;
            var endpoint = hasRotors ? '/Home/DecryptGrokWithKey' : '/Home/DecryptGrok';

            $.ajax({
                url: endpoint,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ciphertext: ciphertext,
                    rotor1: rotor1,
                    rotor2: rotor2,
                    rotor3: rotor3,
                    plugboardPairs: pairs
                }),
                success: function (res) {
                    // Preia corect proprietatea "plaintext" returnată de controller
                    $('#lt-plaintext-grok').val(res.plaintext);

                    // Dacă s-a folosit spargerea automată, actualizăm și rotoarele în interfață
                    if (res.rotor1) $('#lt-letter-grok-1').val(res.rotor1);
                    if (res.rotor2) $('#lt-letter-grok-2').val(res.rotor2);
                    if (res.rotor3) $('#lt-letter-grok-3').val(res.rotor3);
                },
                error: function (xhr) {
                    var msg = (xhr.responseJSON && xhr.responseJSON.error)
                        ? xhr.responseJSON.error
                        : 'An error occurred during decoding.';
                    alert(msg);
                }
            });
        });
    })();
</script>