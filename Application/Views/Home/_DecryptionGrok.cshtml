<h2 class="converter-title">DECRYPTION GROK</h2>

<div class="colleague-workspace">
    <section class="card lt-converter" aria-label="Formular Decryption Grok">
        <!-- Caseta pentru textul codificat (Input) -->
        <div class="lt-row" style="margin-bottom: 20px;">
            <div class="lt-field" style="width: 100%;">
                <label for="lt-ciphertext-grok">Ciphertext</label>
                <textarea id="lt-ciphertext-grok" rows="5" placeholder="Enter the cipher here..."></textarea>
            </div>
        </div>

        <!-- Butonul de conversie -->
        <div style="text-align: center; margin-bottom: 20px;">
            <button type="button" class="lt-button">DECODE</button>
        </div>

        <!-- Caseta pentru textul decodificat (Output) -->
        <div class="lt-row">
            <div class="lt-field" style="width: 100%;">
                <label for="lt-plaintext-grok">Plaintext</label>
                <textarea id="lt-plaintext-grok" rows="5" placeholder="The plaintext will appear here..." readonly style="background-color: #f9f6f0;"></textarea>
            </div>
        </div>
    </section>
</div>