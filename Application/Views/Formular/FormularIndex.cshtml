@{
    ViewData["Title"] = "Formular";
    var letters = Enumerable.Range('A', 26).Select(c => ((char)c).ToString()).ToList();
}

<section class="card lt-converter" aria-label="Formular">
    <h1 class="card-title">Formular</h1>

    <div class="lt-row">
        <div class="lt-field">
            <label for="lt-input">Text</label>
            <textarea id="lt-input" rows="6" placeholder="ex: scrie un text aici"></textarea>
        </div>
        <button type="button" class="lt-button">CONVERTEȘTE</button>
    </div>

    <fieldset class="lt-letters">
        <legend class="lt-legend">Rotoare</legend>

        @* Primele 3 casete *@
        <div class="lt-grid lt-grid-first">
            @for (int i = 1; i <= 3; i++)
            {
                <div class="lt-cell">
                    <span>@i</span>
                    <select id="lt-letter-@i" aria-label="Rotorul @i">
                        <option value="">–</option>
                        @foreach (var l in letters)
                        {
                            <option value="@l">@l</option>
                        }
                    </select>
                </div>
            }
        </div>

        <div class="lt-divider" aria-hidden="true"></div>

        @* Restul de 26 de casete *@
        <h2 class="lt-subtitle">Plugboard</h2>
        <div class="lt-grid">
            @for (int i = 4; i <= 29; i++)
            {
                <div class="lt-cell">
                    <span>@letters[i - 4]</span>
                    <select id="lt-letter-@i" aria-label="Litera @i">
                        <option value="">–</option>
                        @foreach (var l in letters)
                        {
                            <option value="@l">@l</option>
                        }
                    </select>
                </div>
            }
        </div>
    </fieldset>
</section>